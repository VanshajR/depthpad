{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Depthpad",
  "version": "0.2.0",
  "identifier": "io.github.vanshajr.depthpad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p depthpad-probe",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Depthpad",
        "width": 1320,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 720,
        "theme": "Dark",
        "backgroundColor": "#101010",
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Depthpad",
    "copyright": "Copyright (c) Depthpad contributors. Licensed under AGPL-3.0.",
    "license": "AGPL-3.0-only",
    "resources": {
      "redist/ViGEmBus_1.22.0_x64_x86_arm64.exe": "redist/ViGEmBus_1.22.0_x64_x86_arm64.exe",
      "../target/release/depthpad-probe.exe": "depthpad-probe.exe"
    },
    "category": "Utility",
    "shortDescription": "Analog game controller for Hall-effect keyboards",
    "longDescription": "Depthpad turns how far you press each key on a Hall-effect keyboard into a virtual game controller: analog movement, throttle and steering from your keyboard.",
    "homepage": "https://github.com/VanshajR/depthpad",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "headerImage": "./windows/installer-header.bmp",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "installerIcon": "./icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxODU1NTFBNDFDOUQzOTkKUldTWjA4bEJHbFdGMFd4dUVZV0Ric3R1dXV1NDRvUFlJWnBxUDNyY09OdWZsM1RGMGpWREduZE4K",
      "endpoints": [
        "https://github.com/VanshajR/depthpad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
